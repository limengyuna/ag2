# NexusAI 环境变量模板
# 用法：cp .env.example .env 后填入你的真实 key

# ---------- LLM / Embedding 凭证（必填）----------
# DeepSeek（推理模型）：https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# 阿里通义（Embedding）：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# ---------- 安全 ----------
# 使用足够长的随机字符串
JWT_SECRET_KEY=
POSTGRES_PASSWORD=

# ---------- Tavily Search API（Web 搜索）----------
# 在 Tavily 控制台创建 API Key
TAVILY_API_KEY=

# ---------- 可选 ----------
# 默认即可
# LLM_PROVIDER=deepseek
# EMBEDDING_PROVIDER=tongyi
# Pro 模型思考模式开关（true=开启/默认，false=关闭可加速响应）
# DEEPSEEK_THINKING_ENABLED=true

# ---------- ChromaDB 模式选择 ----------
# 默认走 HTTP 模式（连 docker-compose 中的 chroma 容器，本地开发用）
# 部署到 Railway / 单机生产时取消下行注释，启用嵌入式模式（无需独立 chroma 服务）
# CHROMA_PERSIST_PATH=/data/chroma
